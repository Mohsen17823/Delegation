<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="Delegation_category" model="ir.module.category" >
            <field name="name">Delegation</field>
        </record>

        <record id="group_admin_delegation" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="delegation.Delegation_category"/>
        </record>

        <record id="group_requester_delegation" model="res.groups">
            <field name="name">Requester</field>
            <field name="category_id" ref="delegation.Delegation_category"/>
        </record>

        <!--    Requester group only see his own created records    -->
        <record id="delegation_requester_rule" model="ir.rule">
            <field name="name">Delegation By Requester</field>
            <field name="model_id" ref="delegation.model_delegations"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('delegation.group_requester_delegation'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


    </data>
</odoo>